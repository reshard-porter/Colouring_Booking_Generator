# Copy to .env (optional). Nothing here is required for the core app.
# Where projects, files and exports are stored (default: ~/.local/share/coloring-book-studio)
CBS_DATA_DIR=
# Local server address. The app refuses non-local hosts (no authentication in the local edition).
CBS_HOST=127.0.0.1
CBS_PORT=8765
# Seed the "Cute Island Adventures" sample project on first start (1/0)
CBS_SEED_SAMPLE=1
# Optional AI provider key. You can also set it in Settings (stored in a 0600 file in the data dir).
# Generation is billed by the provider. Leave empty to keep AI generation disabled.
OPENAI_API_KEY=
